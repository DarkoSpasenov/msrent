# Mot de passe de l'administration (/admin). Obligatoire, au moins 10 caractères.
ADMIN_PASSWORD=
# Clé secrète pour signer la session admin (chaîne aléatoire longue). Générer : openssl rand -hex 32
SESSION_SECRET=
# Adresse publique du site (pour le SEO, le sitemap et Open Graph)
SITE_URL=https://www.msrent.ch
# Dossier des données (base SQLite + photos). Par défaut : ./data
# DATA_DIR=/srv/msrent-data
